# Copy to .dev.vars for local development (never commit .dev.vars)
#
# GitHub OAuth App: https://github.com/settings/developers
#   Homepage URL: http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/oauth/github/callback
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
#   Authorized redirect URI: http://localhost:5173/api/auth/oauth/google/callback
#
# Auth0 → Applications → Single Page or Regular Web Application
#   Allowed Callback URL: http://localhost:5173/api/auth/oauth/auth0/callback
#   AUTH0_DOMAIN is the tenant host only, such as tenant.us.auth0.com
#
# Browser SDK (Vite). These are public. Put them in .env, not .dev.vars:
#   VITE_AUTH0_DOMAIN=
#   VITE_AUTH0_CLIENT_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
OAUTH_STATE_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
ADMIN_EMAILS=info@silkmoments.com
